  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@tipiment/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "jose": "^5.10.0",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "sharp": "^0.34.2",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
